<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/imageEmployee"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_marginEnd="24dp"
        android:src="@drawable/placeholder"
        android:contentDescription="@string/employee_photo"/>

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/textName"
            android:text="Иванов Иван Иванович"
            android:textSize="22sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/textPosition"
            android:text="Слесарь"
            android:textSize="18sp"
            android:layout_marginTop="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:id="@+id/textGender"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Пол: Мужской"
            android:layout_marginTop="8dp"
            android:textSize="14sp"
            android:textColor="@color/factory_text_dark" />

        <TextView
            android:id="@+id/textAge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Возраст: 35 лет"
            android:layout_marginTop="4dp"
            android:textSize="14sp"
            android:textColor="@color/factory_text_dark" />

        <TextView
            android:id="@+id/textExperience"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Стаж: 10 лет"
            android:layout_marginTop="4dp"
            android:textSize="14sp"
            android:textColor="@color/factory_text_dark" />
    </LinearLayout>
</LinearLayout>